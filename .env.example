SCOPUS_API_KEY=your_scopus_api_key_here
# Optional: Allows abstract retrieval if you use an institutional token
SCOPUS_INST_TOKEN=your_institutional_token_here
# Email used for polite API rate-limiting via OpenAlex and Unpaywall
CONTACT_EMAIL=your_email@example.com
# Optional: Semantic Scholar API Key for TLDRs and citation graphs (1 req/sec limit)
S2_API_KEY=your_s2_api_key_here
# Optional: Comma-separated list of active Sci-Hub mirrors for fallback PDF resolution
SCIHUB_MIRRORS=https://sci-hub.ru,https://sci-hub.st,https://sci-hub.se,https://sci-hub.ru,https://sci-hub.box,https://sci-hub.red,https://sci-hub.su
# Optional: Comma-separated list of active Libgen mirrors for book PDF/EPUB resolution
LIBGEN_MIRRORS=https://libgen.la,http://libgen.li,https://libgen.gl,https://libgen.bz,https://libgen.vg
